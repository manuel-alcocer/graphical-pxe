# Network interface facing the PXE clients (run './pxe init' to auto-detect)
INTERFACE=eth0
# IP of this server on that interface (used by Windows Setup to reach the SMB share)
SERVER_IP=192.168.1.10

# proxy: keep your router's DHCP, we only add PXE boot info (recommended)
# full:  we are the DHCP server (isolated lab networks only!)
DHCP_MODE=proxy
PROXY_SUBNET=192.168.1.0
# Only for DHCP_MODE=full:
#DHCP_RANGE=192.168.50.100,192.168.50.200,12h
#DHCP_GATEWAY=192.168.50.1
#DHCP_DNS=1.1.1.1

# SMB credentials used by WinPE to read the Windows installation files
SMB_USER=pxe
SMB_PASS=pxe

# Main menu timeout in seconds (0 = wait forever; otherwise boots local disk)
MENU_TIMEOUT=0

# Only for `./pxe push` (Kubernetes deployment, see deploy/k8s):
#K8S_CONTEXT=my-cluster
#K8S_NAMESPACE=pxe

# Control center web UI (http://<server>:8000), user "admin". Empty = no login.
ADMIN_PASSWORD=
#TZ=Europe/Madrid
